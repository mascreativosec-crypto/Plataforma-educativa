# Cloud SQL runtime environment variables (injected automatically by AI Studio)
SQL_HOST="MY_SQL_HOST"
SQL_DB_NAME="MY_SQL_DB_NAME"
SQL_USER="MY_SQL_USER"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_ADMIN_USER="MY_SQL_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# SSO y sesiones del Aula (compartidos con CRM ALLEN)
JWT_SECRET="CAMBIAR_SECRETO_32_BYTES_MINIMO"
JWT_EXPIRA="1h"
REFRESH_SECRET="CAMBIAR_REFRESH_SECRETO_32_BYTES"
REFRESH_EXPIRA="7d"
SSO_TICKET_SECRET="CAMBIAR_SSO_TICKET_SECRETO"

# Integración bidireccional con CRM ALLEN (HMAC-SHA256)
ALLEN_API_URL="https://apiaallen.feraxpartner.com/api"
AULA_HMAC_SECRET="CAMBIAR_AULA_HMAC_SECRETO"
ALLEN_HMAC_SECRET="CAMBIAR_ALLEN_HMAC_SECRETO"

# Acceso Administrador Total (llave maestra para gestión de docentes, estudiantes y notas >48h)
ADMIN_MASTER_KEY=""

# App y zona horaria
APP_URL="MY_APP_URL"
ALLEN_APP_URL="https://appallen.feraxpartner.com"
CORS_ORIGENES="http://localhost:3000"
TZ="America/Guayaquil"
